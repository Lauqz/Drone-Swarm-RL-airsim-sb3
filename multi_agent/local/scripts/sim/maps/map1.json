{
  "name": "map1",
  "comment": "Reconstruction of the default UE4 training map from imgs/trajectory_map1_3drones.png. Plan positions were recovered photogrammetrically: the floor-plane homography was fitted from the left/right/top wall-base lines plus the near-wall cap line (vanishing points V_x, V_y), scaled by the known target position (26.8, 3.9) from the legacy env_config.yml, and the y-scale fixed by requiring the floor tiles to be square (they come out 3.45 m). Every obstacle footprint below was read by inverse-projecting its floor-contact pixels through that homography, so plan positions and proportions match the screenshot to roughly +-0.5 m. Heights are visual estimates (single-view height recovery was not reliable) chosen to match the image and to straddle the drones' -8..-1 m spawn band. Coordinates are NED metres: x toward the target, y right, z down (negative = altitude).",
  "arena": {
    "x_min": -1.5,
    "x_max": 27.2,
    "y_min": -20.0,
    "y_max": 20.0,
    "wall_height": 12.0,
    "wall_thickness": 0.8,
    "cap": 0.45,
    "comment": "Back wall sits 1.5 m behind the spawn line. Photogrammetry puts the left wall essentially at x=0, but the drones spawn at x=0 with a 0.35 m body radius, so it is set back just enough to keep the spawn band clear."
  },
  "ceiling": {
    "height": 12.0,
    "material": "ceiling",
    "comment": "Invisible from outside (the viewer never draws it, so the arena stays readable from above) but fully opaque to the drones' cameras and solid to collisions, exactly like the capture ceiling in the UE map. Textured like the floor."
  },
